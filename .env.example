# Copy to .env and fill in. Never commit .env. Synthetic data only.

# --- the model (pick one provider) ---------------------------------------------
LLM_PROVIDER=groq              # groq | foundry | offline
GROQ_API_KEY=                  # for groq
# For Azure AI Foundry or any OpenAI-compatible endpoint:
# LLM_PROVIDER=foundry
# LLM_BASE_URL=https://<your-endpoint>/openai/v1/
# LLM_MODEL=gpt-oss-120b
# LLM_API_KEY=                 # or FOUNDRY_AUTH=managed_identity on an Azure machine

# --- the hospital's EHR (leave empty to use the local synthetic files) ----------
POC_EHR_URL=
POC_EHR_PUBLIC_URL=
POC_FHIR_CLIENT_ID=
POC_FHIR_KEY_FILE=             # path to the private key made by scripts/make_keypair.py
